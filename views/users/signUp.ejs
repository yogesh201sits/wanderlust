<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3 mb-5">Sign up on Wander Lust</h1>
    <div class="col-6 offset-3">
        <form action="/signup" method="post" class="needs-validation" novalidate>
            
        <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input name="username" class="form-control" placeholder="Enter Username" id="username" type="text" required>
            <div class="valid-feedback">Looks good</div>
        </div>
        
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input name="email" class="form-control" placeholder="Enter email" id="email" type="email" required>
        </div>
        
        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input name="password" class="form-control" placeholder="Enter Password" id="password" type="password" required>
            <div class="invalid-feedback">Enter valid password</div>
        </div>
        <button class="btn btn-danger">Sign Up</button>
        </form>
    </div>
</div>