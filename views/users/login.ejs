<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3 mb-5">Login</h1>
    <div class="col-6 offset-3">
        <form action="/login" method="post" class="needs-validation" novalidate>
            
        <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input name="username" class="form-control" placeholder="Enter Username" id="username" type="text" required>
           
        </div>
        
        
        
        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input name="password" class="form-control" placeholder="Enter Password" id="password" type="password" required>
        </div>
        <button class="btn btn-danger">Login</button>
        </form>
    </div>
</div>